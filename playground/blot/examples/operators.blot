// Custom operators.
//
// Any spelling from the operator character class is available. The header
// supplies precedence, associativity, and the function to dispatch to; the
// parser knows none of it, because expressions parse as flat chains and
// precedence is resolved semantically.

operators {
  infixl 45 (:|) = @type.union;
  infixl 45 (:-) = @type.diff;
  infixr 30 (<>) = Text.append;
  infixl 15 (<%>) = Fn.pipe;
  infix 35 (=~) = Ord.le;
  prefix 90 (~) = Num.negate;
};

open {} = (@import "blot:prelude") ();

const Value = I32 :| Str;
const Method = "GET" :| "POST" :| "PUT";
const Verb = Method :- "PUT";

// Division and the comment marker coexist: an operator may contain `/`
// anywhere except as a doubled prefix, which is what keeps `//` a comment.
let ratio = 22 / 7;
let chained = 1 + 2 * 3 - 4 / 2;
let compared = 1 + 2 == 3;

// Associativity and precedence are the header's business, not the grammar's.
let joined = "a" <> "b" <> "c";
let piped = 20 <%> Num.add 2 <%> Num.mul 2;
let applied = Num.add 20 $ 22;
let bounded = 3 =~ 4;
let negated = ~7 + 10;

// --- what the default levels mean -------------------------------------------
//
// Precedence is grouped by what an operator does, and each of these pins a
// relationship that was wrong once. The parenthesised form is what the bare
// form must mean.

// An arrow is looser than the type algebra on either side of it, so each pair
// here prints the same value twice. `==` cannot state it: it compares scalars,
// and these are types.
const arrow_bare = Int | Str -> Int;
const arrow_grouped = (Int | Str) -> Int;

// Set algebra mirrors arithmetic: intersection is the product.
const algebra_bare = 0 | 1 & 1;
const algebra_grouped = 0 | (1 & 1);

// `&&` and `||` are boolean logic, distinct from `&` and `|`, which are set
// algebra. Comparisons bind tighter than both, and `&&` tighter than `||`.
//
// Both arguments are evaluated. An operator here is an ordinary curried
// function and blot has no laziness for one to exploit, so `if` is the
// short-circuiting form.
let ranged = 1 < 2 && 3 < 4;
let either = False && True || True;
let precedence = True || False && False;

// Append binds tighter than comparison and looser than arithmetic. `==` is
// `Ord.eq` over `@int.cmp`, so it compares integers; `Text.cmp` compares text.
let appended = is_equal (Text.cmp ("a" <> "b") "ab");
let counted = "n" <> Text.of_int (1 + 2);

return {
  .arrow_bare = arrow_bare;
  .arrow_grouped = arrow_grouped;
  .algebra_bare = algebra_bare;
  .algebra_grouped = algebra_grouped;
  .ranged = ranged;
  .either = either;
  .precedence = precedence;
  .appended = appended;
  .counted = counted;
  .value = Value;
  .verb = Verb;
  .ratio = ratio;
  .chained = chained;
  .compared = compared;
  .joined = joined;
  .piped = piped;
  .applied = applied;
  .bounded = bounded;
  .negated = negated;
};
