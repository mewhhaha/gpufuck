// A `:=` inside a statement `if` escapes the conditional.
//
// A branch is a scope for `let`, which introduces a name, but not for `:=`,
// which hands an existing one back: a rebinding requires the name to be in
// scope already and to keep its type, so both paths agree on what it holds and
// there is always an outer binding to hand it to. That is what lets a
// statement conditional compute rather than only `return`, `break`, or perform.
//
// The shape that matters is the conditional being the *last* statement of a
// `for`. A loop's accumulator is the set of names its body rebinds, and a name
// rebound only inside a branch is still one of them.

open {} = (@import "blot:prelude") ();

// One branch, last statement of the loop. The missing `else` is the
// pass-through: it hands `counted` back as it already is.
let counted = 0;
for x in Iter.range (0, 5) do
  if x > 2 then do counted := counted + 1; end;
end;

// Both branches rebind, still last.
let scored = 0;
for x in Iter.range (0, 5) do
  if x > 2 then do scored := scored + 1; else do scored := scored + 10; end;
end;

// The conditional in the middle of a body, with an ordinary rebinding after it.
let mixed = 0;
for x in Iter.range (0, 5) do
  if x > 2 then do mixed := mixed + 1; end;
  mixed := mixed * 2;
end;

// Two names, only one of them rebound inside the branch.
let evens = 0;
let seen = 0;
for x in Iter.range (0, 6) do
  seen := seen + 1;
  if x % 2 == 0 then do evens := evens + 1; end;
end;

// A `let` inside the branch stays branch-local: it is a new name with a
// possibly new type, and a name bound only when a condition happened to hold
// is exactly what must not leak.
let scaled = 0;
for x in Iter.range (0, 4) do
  if x > 0 then do
    let step = x * 3;
    scaled := scaled + step;
  end;
end;

// The same threading outside a loop.
let flagged = 0;
if 1 < 2 then do flagged := flagged + 1; end;

return {
  .counted = counted;
  .scored = scored;
  .mixed = mixed;
  .evens = evens;
  .seen = seen;
  .scaled = scaled;
  .flagged = flagged;
};
