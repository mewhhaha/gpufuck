-- A modal editor. All of it -- buffer, cursor, modes, every command -- is here;
-- the Deno host in `sweep_vim.ts` does terminal I/O and nothing else.
--
-- `main` takes the whole key history and replays it from empty. That sounds
-- quadratic and measures linear: each `step` is O(1) on a zipper, so a replay is
-- one pass. Measured, 25 keys take 0.2 ms and 2,000 take 3.2 ms -- per-key cost
-- falls from 9.4 to 1.6 microseconds as the fixed cost amortizes.
--
-- The trade it buys is that the host holds no editor state at all, so there is
-- nothing that can drift out of sync with this file.

type Line = Empty | Char(code: Int, rest: Line);

-- `before` is stored reversed so inserting at the cursor is one cons.
type Zipper = Zipper(before: Line, after: Line);

type Buffer = NoLines | Lines(head: Zipper, tail: Buffer);

type Document = Document(above: Buffer, current: Zipper, below: Buffer);

type Mode = Normal | Insert;

type State = State(document: Document, mode: Mode, quit: Bool);

type Keys = NoKeys | Press(code: Int, rest: Keys);

export step, start;

-- ------------------------------------------------------------------- lines

fn lineLength(line: Line) -> Int =
  match line {
    Empty -> 0;
    Char(code, rest) -> 1 + lineLength(rest);
  };

fn lineAppend(front: Line, back: Line) -> Line =
  match front {
    Empty -> back;
    Char(code, rest) -> Char(code, lineAppend(rest, back));
  };

fn lineReverseOnto(line: Line, accumulator: Line) -> Line =
  match line {
    Empty -> accumulator;
    Char(code, rest) -> lineReverseOnto(rest, Char(code, accumulator));
  };

-- ------------------------------------------------------------------ zipper

fn zipperText(zipper: Zipper) -> Line =
  match zipper {
    Zipper(before, after) -> lineReverseOnto(before, after);
  };

fn zipperColumn(zipper: Zipper) -> Int =
  match zipper {
    Zipper(before, after) -> lineLength(before);
  };

fn zipperLeft(zipper: Zipper) -> Zipper =
  match zipper {
    Zipper(before, after) ->
      match before {
        Empty -> Zipper(Empty, after);
        Char(code, rest) -> Zipper(rest, Char(code, after));
      };
  };

fn zipperRight(zipper: Zipper) -> Zipper =
  match zipper {
    Zipper(before, after) ->
      match after {
        Empty -> Zipper(before, Empty);
        Char(code, rest) -> Zipper(Char(code, before), rest);
      };
  };

fn zipperHome(zipper: Zipper) -> Zipper =
  match zipper {
    Zipper(before, after) -> Zipper(Empty, lineReverseOnto(before, after));
  };

fn zipperEnd(zipper: Zipper) -> Zipper =
  match zipper {
    Zipper(before, after) -> Zipper(lineReverseOnto(after, before), Empty);
  };

fn zipperInsert(zipper: Zipper, code: Int) -> Zipper =
  match zipper {
    Zipper(before, after) -> Zipper(Char(code, before), after);
  };

-- Normal-mode `x`: delete the character under the cursor, which is the head of
-- `after`.
fn zipperDelete(zipper: Zipper) -> Zipper =
  match zipper {
    Zipper(before, after) ->
      match after {
        Empty -> Zipper(before, Empty);
        Char(code, rest) -> Zipper(before, rest);
      };
  };

fn zipperBackspace(zipper: Zipper) -> Zipper =
  match zipper {
    Zipper(before, after) ->
      match before {
        Empty -> Zipper(Empty, after);
        Char(code, rest) -> Zipper(rest, after);
      };
  };

fn zipperBefore(zipper: Zipper) -> Zipper =
  match zipper {
    Zipper(before, after) -> Zipper(before, Empty);
  };

fn zipperAfter(zipper: Zipper) -> Zipper =
  match zipper {
    Zipper(before, after) -> Zipper(Empty, after);
  };

fn zipperJoin(left: Zipper, right: Zipper) -> Zipper =
  match left {
    Zipper(before, after) -> Zipper(before, lineAppend(after, zipperText(right)));
  };

fn emptyZipper() -> Zipper = Zipper(Empty, Empty);

-- ---------------------------------------------------------------- document

fn documentCurrent(document: Document) -> Zipper =
  match document {
    Document(above, current, below) -> current;
  };

fn documentEdit(document: Document, edited: Zipper) -> Document =
  match document {
    Document(above, current, below) -> Document(above, edited, below);
  };

-- Vertical motion keeps the column where it can, which is what makes `j` and `k`
-- feel right rather than snapping to the start of the line.
fn clampColumn(zipper: Zipper, column: Int) -> Zipper =
  if column < 1 then zipperHome(zipper)
  else clampColumn(zipperRight(zipperHome(zipper)), column - 1);

fn moveToColumn(zipper: Zipper, column: Int) -> Zipper =
  if column < 1 then zipperHome(zipper) else clampColumn(zipper, column);

fn documentUp(document: Document) -> Document =
  match document {
    Document(above, current, below) ->
      match above {
        NoLines -> Document(NoLines, current, below);
        Lines(head, tail) ->
          Document(tail, moveToColumn(head, zipperColumn(current)), Lines(current, below));
      };
  };

fn documentDown(document: Document) -> Document =
  match document {
    Document(above, current, below) ->
      match below {
        NoLines -> Document(above, current, NoLines);
        Lines(head, tail) ->
          Document(Lines(current, above), moveToColumn(head, zipperColumn(current)), tail);
      };
  };

-- Enter in insert mode, and `o` in normal mode.
fn documentSplit(document: Document) -> Document =
  match document {
    Document(above, current, below) ->
      Document(Lines(zipperBefore(current), above), zipperAfter(current), below);
  };

fn documentOpenBelow(document: Document) -> Document =
  match document {
    Document(above, current, below) ->
      Document(Lines(current, above), emptyZipper(), below);
  };

fn documentJoin(document: Document) -> Document =
  match document {
    Document(above, current, below) ->
      match below {
        NoLines -> Document(above, current, NoLines);
        Lines(head, tail) -> Document(above, zipperJoin(current, head), tail);
      };
  };

-- Backspace at column zero joins with the line above instead of doing nothing.
fn documentBackspace(document: Document) -> Document =
  if zipperColumn(documentCurrent(document)) > 0
  then documentEdit(document, zipperBackspace(documentCurrent(document)))
  else joinWithAbove(document);

fn joinWithAbove(document: Document) -> Document =
  match document {
    Document(above, current, below) ->
      match above {
        NoLines -> Document(NoLines, current, below);
        Lines(head, tail) -> Document(tail, zipperJoin(zipperEnd(head), current), below);
      };
  };

-- ------------------------------------------------------------------- modes

-- Written as nested ifs rather than a chained comparison: `a >= b == c < d` parses
-- as `(a >= b) == (c < d)`, and structural equality on Bool is not what Core offers.
fn isPrintable(code: Int) -> Bool =
  if code < 32 then false else if code > 126 then false else true;

fn normalCommand(state: State, code: Int) -> State =
  match state {
    State(document, mode, quit) ->
      if code == 104 then State(documentEdit(document, zipperLeft(documentCurrent(document))), Normal, false)
      else if code == 108 then State(documentEdit(document, zipperRight(documentCurrent(document))), Normal, false)
      else if code == 107 then State(documentUp(document), Normal, false)
      else if code == 106 then State(documentDown(document), Normal, false)
      else if code == 48 then State(documentEdit(document, zipperHome(documentCurrent(document))), Normal, false)
      else if code == 36 then State(documentEdit(document, zipperEnd(documentCurrent(document))), Normal, false)
      else if code == 120 then State(documentEdit(document, zipperDelete(documentCurrent(document))), Normal, false)
      else if code == 105 then State(document, Insert, false)
      else if code == 97 then State(documentEdit(document, zipperRight(documentCurrent(document))), Insert, false)
      else if code == 65 then State(documentEdit(document, zipperEnd(documentCurrent(document))), Insert, false)
      else if code == 73 then State(documentEdit(document, zipperHome(documentCurrent(document))), Insert, false)
      else if code == 111 then State(documentOpenBelow(document), Insert, false)
      else if code == 74 then State(documentJoin(document), Normal, false)
      else if code == 113 then State(document, Normal, true)
      else State(document, Normal, false);
  };

fn insertCommand(state: State, code: Int) -> State =
  match state {
    State(document, mode, quit) ->
      if code == 27 then State(document, Normal, false)
      else if code == 13 then State(documentSplit(document), Insert, false)
      else if code == 10 then State(documentSplit(document), Insert, false)
      else if code == 127 then State(documentBackspace(document), Insert, false)
      else if code == 8 then State(documentBackspace(document), Insert, false)
      else if isPrintable(code)
      then State(documentEdit(document, zipperInsert(documentCurrent(document), code)), Insert, false)
      else State(document, Insert, false);
  };

fn step(state: State, code: Int) -> State =
  match state {
    State(document, mode, quit) ->
      match mode {
        Normal -> normalCommand(state, code);
        Insert -> insertCommand(state, code);
      };
  };

fn start() -> State = State(Document(NoLines, emptyZipper(), NoLines), Normal, false);

fn replay(state: State, keys: Keys) -> State =
  match keys {
    NoKeys -> state;
    Press(code, rest) -> replay(step(state, code), rest);
  };

-- The host hands over the whole key history and gets the state back. It keeps no
-- editor state of its own.
fn main(keys: Keys) -> State = replay(start(), keys);
