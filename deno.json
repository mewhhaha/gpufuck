{
  "name": "@mewhhaha/gpufuck",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    ".": "./functional.ts",
    "./core": "./core.ts"
  },
  "unstable": [
    "webgpu"
  ],
  "imports": {
    "@mewhhaha/baba": "jsr:@mewhhaha/baba@5.1.0",
    "@mewhhaha/baba/runtime/generated-wasm": "jsr:@mewhhaha/baba@5.1.0/runtime/generated-wasm"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true
  },
  "fmt": {
    "exclude": [
      "language/lazuli/generated",
      "language/gleam/generated",
      "examples/javascript-aot/language/generated",
      "examples/gleam-functional/*.trace.md",
      ".claude"
    ],
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "publish": {
    "include": [
      "ARCHITECTURE.md",
      "BASELINE.md",
      "CHANGELOG.md",
      "DEVELOPMENT.md",
      "LICENSE",
      "README.md",
      "core.ts",
      "deno.json",
      "functional.ts",
      "src/functional/abi.ts",
      "src/functional/compilation_admission.ts",
      "src/functional/compiler.ts",
      "src/functional/compiler_module.ts",
      "src/functional/core_artifact.ts",
      "src/functional/diagnostics.ts",
      "src/functional/evaluator.ts",
      "src/functional/gpu_dispatch_scheduler.ts",
      "src/functional/host_contract.ts",
      "src/functional/module_contract.ts",
      "src/functional/recursive_groups.ts",
      "src/functional/schema_contract.ts",
      "src/functional/static_literals.ts",
      "src/functional/surface_builder.ts",
      "src/functional/surface_contract.ts",
      "src/semantic/abi.ts",
      "src/semantic/compilation_diagnostics.ts",
      "src/semantic/compiler_module.ts",
      "src/semantic/compiler_shader.ts",
      "src/semantic/definition_wavefront.ts",
      "src/semantic/evaluator.ts",
      "src/semantic/evaluator_shader.ts",
      "src/semantic/gpu_batch_compiler.ts",
      "src/semantic/gpu_batch_results.ts",
      "src/semantic/gpu_semantic_compiler.ts",
      "src/semantic/gpu_semantic_contract.ts",
      "src/semantic/gpu_type_inference_contract.ts",
      "src/semantic/gpu_type_inference_gpu_io.ts",
      "src/semantic/gpu_type_inference_results.ts",
      "src/semantic/gpu_type_inference_runner.ts",
      "src/semantic/gpu_type_inference_workspace.ts",
      "src/semantic/type_inference.ts",
      "src/semantic/type_inference_shader.ts",
      "src/semantic/type_schema_abi.ts",
      "src/webgpu.ts"
    ]
  },
  "tasks": {
    "bench:lazuli": "deno bench --allow-read=language/lazuli/generated benchmarks/lazuli_compiler_bench.ts",
    "bench:semantic-wavefront": "deno bench benchmarks/semantic_wavefront_bench.ts",
    "bench:throughput": "deno run --unstable-webgpu --allow-read=language/lazuli/generated benchmarks/compile_throughput_bench.ts",
    "check": "deno check mod.ts functional.ts core.ts gleam_functional.ts gleam_functional_cli.ts lazuli_cli.ts benchmarks/*.ts examples/javascript-aot/*.ts tests/*.ts tools/*.ts",
    "check:gleam-stdlib": "deno run --allow-read --allow-run=git --allow-write=/tmp tools/check_gleam_stdlib.ts",
    "check:javascript-test262": "deno run --allow-read --allow-run=git,deno,ps --allow-write=/tmp examples/javascript-aot/check_test262.ts",
    "compile:lazuli": "deno run --allow-read lazuli_cli.ts compile",
    "fmt": "deno fmt --check",
    "generate:gleam": "deno run --allow-read --allow-write jsr:@mewhhaha/baba@5.1.0/cli language/gleam/grammar.baba --metadata language/gleam/baba.json --out language/gleam/generated --name gleam-functional --root module --target wasm",
    "generate:javascript-aot": "deno run --allow-read --allow-write jsr:@mewhhaha/baba@5.1.0/cli examples/javascript-aot/language/grammar.baba --metadata examples/javascript-aot/language/baba.json --out examples/javascript-aot/language/generated --name javascript-aot --root module --target wasm",
    "generate:lazuli": "deno run --allow-read --allow-write jsr:@mewhhaha/baba@5.1.0/cli language/lazuli/grammar.baba --metadata language/lazuli/baba.json --out language/lazuli/generated --name lazuli --root module --target wasm",
    "lint": "deno lint",
    "profile:lazuli-compiler": "deno run --allow-read tools/profile_lazuli_compiler.ts",
    "publish:dry-run": "deno publish --dry-run --allow-dirty",
    "run:gleam-functional": "deno run --allow-read gleam_functional_cli.ts run",
    "run:javascript-aot": "deno run --allow-read examples/javascript-aot/cli.ts",
    "run:lazuli": "deno run --allow-read lazuli_cli.ts run",
    "run:lazuli-batch": "deno run --allow-read lazuli_cli.ts run-batch",
    "test": "DENO_JOBS=2 deno test --parallel --allow-read tests/*.ts",
    "trace:gleam-functional": "deno run --allow-read --allow-write gleam_functional_cli.ts trace"
  }
}
